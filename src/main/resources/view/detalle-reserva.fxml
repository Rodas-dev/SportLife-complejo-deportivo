<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="raizDetalle" styleClass="fondo-raiz" stylesheets="@../css/detalle-reserva.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.java.com.rodasdev.sport.life.controller.DetalleReservaController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="barra-superior">
            <padding>
                <Insets bottom="15" left="25" right="25" top="15" />
            </padding>
            <Button fx:id="botonVolver" onAction="#alVolver" styleClass="boton-enlace" text="← Volver" />
            <Label styleClass="texto-logo-chico" text="Confirmar reserva" HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="30" styleClass="contenedor-detalle">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <VBox alignment="TOP_CENTER" spacing="12" styleClass="tarjeta-imagen">
                <ImageView fx:id="imagenCancha" fitHeight="220" fitWidth="320" preserveRatio="true" />
                <Label fx:id="etiquetaDescripcion" styleClass="titulo-cancha" wrapText="true" />
                <Label fx:id="etiquetaTipoDeporte" styleClass="dato-cancha" />
                <Label fx:id="etiquetaPrecioHora" styleClass="dato-cancha" />
            </VBox>

            <VBox alignment="TOP_LEFT" spacing="14" styleClass="tarjeta-formulario">
                <Label styleClass="subtitulo" text="Elige fecha y horario" />

                <DatePicker fx:id="selectorFecha" onAction="#alCambiarFecha" promptText="Fecha" styleClass="campo-fecha" />

                <HBox spacing="12">
                    <ComboBox fx:id="comboHoraInicio" onAction="#alCambiarHorario" promptText="Hora inicio" styleClass="campo-combo" />
                    <ComboBox fx:id="comboHoraFin" onAction="#alCambiarHorario" promptText="Hora fin" styleClass="campo-combo" />
                </HBox>

                <Label fx:id="etiquetaOcupados" styleClass="etiqueta-ocupados" wrapText="true" />
                <Label fx:id="etiquetaMensaje" styleClass="mensaje-error" wrapText="true" />

                <Label fx:id="etiquetaMontoTotal" styleClass="monto-total" text="Total: Q0.00" />

                <Button fx:id="botonConfirmar" maxWidth="Infinity" onAction="#alConfirmarReserva"
                        styleClass="boton-primario" text="Confirmar Reserva" />
            </VBox>
        </HBox>
    </center>
</BorderPane>
